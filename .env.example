# ─────────────────────────────────────────────────────────────
# Behavior-Based Authentication System — Environment Variables
# Copy this file to .env and fill in production values.
# ─────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-32-byte-string
JWT_SECRET_KEY=change-me-to-a-secure-random-32-byte-string
# Persistent Fernet key for backup-code encryption.
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: If this changes between restarts, existing backup codes become unreadable.
BACKUP_FERNET=

# ── Database ─────────────────────────────────────────────────
DATABASE_PATH=database/auth_system.db

# ── Redis (required for production) ──────────────────────────
# Needed for: rate limiting, JWT blocklist, nonce replay protection,
# session cache, and behavioral feature cache.
REDIS_URL=redis://localhost:6379/0

# ── Flask ────────────────────────────────────────────────────
DEBUG=false
FLASK_ENV=production

# ── JWT ──────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES_HOURS=1
JWT_PREVIOUS_SECRET_KEY=

# ── CSRF ─────────────────────────────────────────────────────
CSRF_ENABLED=true
# CSRF tokens are now per-session (signed with SECRET_KEY).
# The legacy CSRF_TOKEN config value is no longer used.

# ── CORS ─────────────────────────────────────────────────────
# Set to your frontend origin(s), comma-separated. NEVER use * in production.
CORS_ORIGINS=http://localhost:3000

# ── Transaction Signing ──────────────────────────────────────
TXN_SIGNING_KEY=change-me-to-a-secure-signing-key
TXN_SIGNING_PREVIOUS_KEY=
TRANSACTION_SIGNING_REQUIRED=true

# ── Rate Limiting ────────────────────────────────────────────
# Use Redis for multi-worker deployments. Falls back to memory:// (single-process only).
RATELIMIT_STORAGE_URI=redis://localhost:6379/0

# ── Security Headers ─────────────────────────────────────────
CSP_POLICY=default-src 'self'
HSTS_MAX_AGE=31536000
REFERRER_POLICY=no-referrer

# ── Email / SMTP ─────────────────────────────────────────────
# Required for password-reset email delivery. Without SMTP credentials,
# the system falls back to logging emails to the console (dev only).
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@behaviorauth.local
# Backend: 'smtp' | 'ses' | 'console' (auto-detected from credentials if blank)
MAIL_BACKEND=
# AWS region (only when MAIL_BACKEND=ses)
AWS_REGION=us-east-1
# Base URL for the password-reset page in the frontend
RESET_URL_BASE=https://app.example.com/reset-password

# ── Risk Thresholds ──────────────────────────────────────────
RISK_HIGH_THRESHOLD=0.65
RISK_MEDIUM_THRESHOLD=0.35
STEP_UP_RISK_SCORE_THRESHOLD=0.6

# ── RBAC (comma-separated usernames) ─────────────────────────
ADMIN_USERNAMES=
ANALYST_USERNAMES=

# ── Session ──────────────────────────────────────────────────
SESSION_CACHE_TTL_SECONDS=28800
SESSION_TIMEOUT_HOURS=8

# ── ML Models ────────────────────────────────────────────────
MODELS_BASE_PATH=models/saved
CALIBRATION_MIN_SAMPLES=30
ANOMALY_THRESHOLD=0.15
CONFIDENCE_THRESHOLD=0.7
